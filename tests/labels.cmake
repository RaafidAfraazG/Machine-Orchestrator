set(mo_tests ${mo_tests_TESTS})
foreach(test IN LISTS mo_tests)
  if(test MATCHES "^FaultScenarios\\.")
    set_tests_properties("${test}" PROPERTIES LABELS "fault;integration")
    if(test MATCHES "Cycle|Abort|Stop|Concurrent|Flood|Aging|Priority|Fifo")
      set_tests_properties("${test}" PROPERTIES LABELS "fault;integration;stress")
    endif()
  elseif(test MATCHES "^(Integration|Workflow|Watchdog)\\.")
    set_tests_properties("${test}" PROPERTIES LABELS integration)
  elseif(test MATCHES "^Regression\\.Concurrent")
    set_tests_properties("${test}" PROPERTIES LABELS "unit;stress")
  elseif(test MATCHES "^Stress\\.")
    set_tests_properties("${test}" PROPERTIES LABELS "stress;integration")
  else()
    set_tests_properties("${test}" PROPERTIES LABELS unit)
  endif()
endforeach()
